        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.4 2.6 2.2 4.4 5 4.6"/></svg>
      </a>
    </div>
  </div>
  <p class="copy">© <span id="yr"></span> Mohammad Alhashlan — All rights reserved</p>
</footer>

<div class="lb" role="dialog" aria-modal="true" aria-label="عرض الصورة">
  <button class="x" aria-label="إغلاق">✕</button>
  <button class="nav-btn prev" aria-label="السابق">›</button>
  <button class="nav-btn next" aria-label="التالي">‹</button>
  <img alt="">
</div>

<script>
(() => {
  const $  = (s, c = document) => c.querySelector(s);
  const $$ = (s, c = document) => Array.from(c.querySelectorAll(s));

  /* =========================================================
     ⚙️  عدّل الصور من هنا فقط
     ========================================================= */
  const results = [
    "assets/img/results/results-01.jpg",
    "assets/img/results/results-02.jpg",
    "assets/img/results/results-03.jpg",
    "assets/img/results/results-04.jpg",
    "assets/img/results/results-05.jpg",
    "assets/img/results/results-06.jpg",
    "assets/img/results/results-07.jpg",
    "assets/img/results/results-08.jpg",
    "assets/img/results/results-09.jpg",
    "assets/img/results/results-10.jpg",
    "assets/img/results/results-11.jpg",
    "assets/img/results/results-12.jpg"
  ];

  const reviews = [
    "assets/img/reviews/reviews-01.jpg",
    "assets/img/reviews/reviews-02.jpg",
    "assets/img/reviews/reviews-03.jpg",
    "assets/img/reviews/reviews-04.jpg",
    "assets/img/reviews/reviews-05.jpg",
    "assets/img/reviews/reviews-06.jpg"
  ];

  /* =========================================================
     الأسئلة الشائعة
     ========================================================= */
  const FAQ = [
    { cat:'sub', q:'كيف أشترك في البرنامج؟',
      a:'اختر الباقة المناسبة واضغط «سجّل الآن» وعبّي الفورم. بعدها يتم مراجعة طلبك وقبوله خلال 3–7 أيام كحد أقصى، وتستلم خطتك خلال ٣–٥ أيام من القبول.' },

    { cat:'sub', q:'متى أستلم خطتي بعد التسجيل؟',
      a:'من ٣ إلى ٥ أيام عمل، لأن الخطة تُبنى بشكل فردي — مو قالب جاهز. تُراجع بياناتك، هدفك، وضعك الصحي، ووقتك المتاح قبل ما تُصمم.' },

    { cat:'sub', q:'هل البرنامج متاح خارج السعودية؟',
      a:'نعم، البرنامج متاح داخل وخارج المملكة. كل شي يتم عن بُعد عبر الواتساب، والدفع إلكتروني.' },

    { cat:'sub', q:'هل يمكن استرجاع المبلغ؟',
      a:'الاشتراك غير قابل للاسترجاع بعد استلام الخطة، لأنها مبنية عليك بشكل فردي. لكن إذا صار أي خطأ من جهتنا في التصميم، نعدّله لك بالكامل.' },

    { cat:'train', q:'هل أحتاج أن أتمرن في النادي؟',
      a:'لا، مو شرط. تقدر تتمرن في البيت بتمارين وأدوات بسيطة. وإذا كنت في النادي، الخطة تُبنى على الأجهزة المتوفرة عندك.' },

    { cat:'train', q:'كم يوم تمرين في الأسبوع؟',
      a:'من يومين إلى ٥ أيام حسب وقتك وهدفك ومستواك. المهم الاستمرارية، مو عدد الأيام.' },

    { cat:'train', q:'هل الجدول الغذائي فيه حرمان؟',
      a:'أبدًا. الجدول محسوب السعرات والماكروز، وفيه مرونة تاكل فيها اللي تحبه ضمن احتياجك اليومي. الممنوع فقط اللي يضرك صحيًا.' },

    { cat:'train', q:'أنا مبتدئ تمامًا، ينفع أشترك؟',
      a:'ينفع وبقوة. الخطة تبدأ من مستواك الحالي، وفيها شرح للحركات الأساسية وكيف ترفع الأوزان بشكل آمن.' },

    { cat:'t1d', q:'أنا مصاب بالسكري النوع الأول، شنو الفرق في البرنامج؟',
      a:'الخطة تُبنى حول السكري مو جنبه. تتعلم حساب الكارب من الصفر، توقيت الأنسولين والوجبات، وتعديل التمرين حسب قراءاتك قبل وبعد التمرين.' },

    { cat:'t1d', q:'أستخدم مضخة أو قلم، هل يفرق؟',
      a:'نعم يفرق في طريقة التعديل. نشتغل على أساس اللي تستخدمه — مضخة أو قلم — ونعدّل التوصيات حسب استجابتك.' },

    { cat:'t1d', q:'عندي حساس قياس مستمر، هل تستفيدون منه؟',
      a:'نعم، بيانات الحساس تساعدنا بشكل كبير في ضبط الخطة الغذائية والتدريبية وتقليل التقلبات. وإذا ما عندك، نشتغل على القياسات اليدوية.' },

    { cat:'t1d', q:'أخاف من الانخفاضات أثناء التمرين، كيف نتعامل معها؟',
      a:'نتعلم كيف نرفع السكر بشكل آمن قبل التمرين، نضبط توقيت الأنسولين، ونحدد الكارب المناسب. هدفنا تتمرن بثقة بدون نوبات هبوط.' }
  ];

  /* ---------- preloader ---------- */
  let done = false;
  const finish = () => {
    if (done) return;
    done = true;
    document.body.classList.add('loaded');
    setTimeout(() => document.body.classList.add('settled'), 2000);
  };
  window.addEventListener('load', () => setTimeout(finish, 350));
  setTimeout(finish, 3500);

  /* ---------- year ---------- */
  const yr = $('#yr');
  if (yr) yr.textContent = new Date().getFullYear();

  /* ---------- hero name split ---------- */
  $$('.name .split').forEach(el => {
    const text = el.textContent;
    el.textContent = '';
    Array.from(text).forEach((ch, i) => {
      const s = document.createElement('span');
      s.className = 'ch';
      s.textContent = ch === ' ' ? '\u00A0' : ch;
      s.style.transitionDelay = (0.4 + i * 0.035).toFixed(3) + 's';
      el.appendChild(s);
    });
  });

  /* ---------- burger / mobile menu ---------- */
  const burger = $('.burger');
  if (burger) {
    burger.addEventListener('click', () => {
      const open = document.body.classList.toggle('menu-open');
      burger.setAttribute('aria-expanded', String(open));
    });
  }
  $$('.mobile-menu a').forEach(a => a.addEventListener('click', () => {
    document.body.classList.remove('menu-open');
    if (burger) burger.setAttribute('aria-expanded', 'false');
  }));

  /* ---------- scroll reveal ---------- */
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      e.target.classList.add('in');
      io.unobserve(e.target);
      setTimeout(() => e.target.classList.add('done'), 1500);
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
  $$('[data-reveal]').forEach(el => io.observe(el));

  /* ---------- counters ---------- */
  const cio = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const el = e.target;
      const target = parseInt(el.dataset.count, 10) || 0;
      const dur = 1300;
      const t0 = performance.now();
      const tick = t => {
        const p = Math.min((t - t0) / dur, 1);
        el.textContent = Math.round(target * (1 - Math.pow(1 - p, 3)));
        if (p < 1) requestAnimationFrame(tick);
        else el.textContent = target;
      };
      requestAnimationFrame(tick);
      cio.unobserve(el);
    });
  }, { threshold: 0.6 });
  $$('[data-count]').forEach(el => cio.observe(el));

  /* ---------- galleries (marquee) ---------- */
  function buildTrack(track, list, tall) {
    if (!track || !list.length) return;
    const frag = document.createDocumentFragment();
    // نسختين لعمل التمرير اللانهائي
    [...list, ...list].forEach(src => {
      const d = document.createElement('div');
      d.className = 'shot' + (tall ? ' tall' : '');
      const img = document.createElement('img');
      img.src = src;
      img.alt = 'صورة من البرنامج';
      img.loading = 'lazy';
      img.decoding = 'async';
      d.appendChild(img);
      frag.appendChild(d);
    });
    track.appendChild(frag);
  }
  buildTrack($('#results-track'), results, false);
  buildTrack($('#reviews-track'), reviews, true);

  /* ---------- lightbox ---------- */
  const lb = $('.lb');
  const lbImg = lb ? $('img', lb) : null;
  let shots = [];
  let idx = 0;

  function refreshShots() { shots = $$('.shot img'); }

  function openLb(i) {
    if (!lb || !lbImg) return;
    refreshShots();
    if (!shots.length) return;
    idx = (i + shots.length) % shots.length;
    lbImg.src = shots[idx].src;
    lbImg.alt = shots[idx].alt || '';
    lb.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeLb() {
    if (!lb) return;
    lb.classList.remove('open');
    document.body.style.overflow = '';
  }

  document.addEventListener('click', e => {
    const shot = e.target.closest('.shot');
    if (!shot) return;
    const img = shot.querySelector('img');
    refreshShots();
    openLb(shots.indexOf(img));
  });
  if (lb) {
    $('.lb .x')?.addEventListener('click', closeLb);
    lb.addEventListener('click', e => { if (e.target === lb) closeLb(); });
    $('.lb .prev')?.addEventListener('click', e => { e.stopPropagation(); openLb(idx + 1); });
    $('.lb .next')?.addEventListener('click', e => { e.stopPropagation(); openLb(idx - 1); });
  }
  document.addEventListener('keydown', e => {
    if (!lb || !lb.classList.contains('open')) return;
    if (e.key === 'Escape') closeLb();
    if (e.key === 'ArrowRight') openLb(idx - 1);
    if (e.key === 'ArrowLeft') openLb(idx + 1);
  });

  /* ---------- pricing ---------- */
  const toggle = $('.toggle');
  if (toggle) {
    const buttons = $$('.toggle button', toggle);
    const pill = $('.toggle .pill', toggle);
    const plans = $$('.plan');
    const PERIODS = [1, 3, 6, 12];
    let current = 1;

    function movePill(btn) {
      if (!btn || !pill) return;
      const r = btn.getBoundingClientRect();
      const pr = toggle.getBoundingClientRect();
      pill.style.width = r.width + 'px';
      pill.style.height = r.height + 'px';
      pill.style.left = (r.left - pr.left) + 'px';
      pill.style.top = (r.top - pr.top) + 'px';
      pill.style.right = 'auto';
      pill.style.bottom = 'auto';
    }

    function animateNumber(el, to) {
      const from = parseFloat(String(el.textContent).replace(/[^\d.]/g, '')) || 0;
      if (from === to) { el.textContent = to.toLocaleString('en-US'); return; }
      const dur = 450;
      const t0 = performance.now();
      el.classList.add('counting');
      const tick = t => {
        const p = Math.min((t - t0) / dur, 1);
        const v = Math.round(from + (to - from) * (1 - Math.pow(1 - p, 3)));
        el.textContent = v.toLocaleString('en-US');
        if (p < 1) requestAnimationFrame(tick);
        else {
          el.textContent = to.toLocaleString('en-US');
          el.classList.remove('counting');
        }
      };
      requestAnimationFrame(tick);
    }

    function setPlan(i) {
      current = i;
      buttons.forEach((b, j) => b.setAttribute('aria-pressed', String(i === j)));
      movePill(buttons[i]);

      plans.forEach(plan => {
        const prices = (plan.dataset.prices || '').split(',').map(n => parseInt(n, 10) || 0);
        const val = $('.val', plan);
        const per = $('.per', plan);
        if (!val || !prices[i]) return;

        animateNumber(val, prices[i]);

        const months = PERIODS[i];
        if (i === 0) {
          per.innerHTML = 'الدفع مرة واحدة · شهر واحد';
        } else {
          const monthly = prices[i] / months;
          const save = (1 - monthly / prices[0]) * 100;
          per.innerHTML = '≈ <b>' + Math.round(monthly).toLocaleString('en-US') +
                          '</b> ر.س شهرياً · وفّر <b>' + save.toFixed(1) + '%</b>';
        }
      });
    }

    buttons.forEach((b, i) => b.addEventListener('click', () => setPlan(i)));

    let rt;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = setTimeout(() => movePill(buttons[current]), 120);
    });

    // تهيئة بدون حركة للـ pill
    if (pill) pill.style.transition = 'none';
    setPlan(1);
    requestAnimationFrame(() => { if (pill) pill.style.transition = ''; });
  }

  /* ---------- FAQ ---------- */
  const faqList = $('#faq-list');
  if (faqList) {
    FAQ.forEach(item => {
      const d = document.createElement('details');
      d.className = 'qa';
      d.dataset.cat = item.cat;
      d.innerHTML =
        '<summary>' + item.q + '<span class="pm"></span></summary>' +
        '<div class="ans"><div><p>' + item.a + '</p></div></div>';
      faqList.appendChild(d);
    });

    $$('#faq-list summary').forEach(sum => {
      sum.addEventListener('click', e => {
        e.preventDefault();
        const qa = sum.parentElement;
        if (qa.classList.contains('show')) {
          qa.classList.remove('show');
          setTimeout(() => qa.removeAttribute('open'), 560);
        } else {
          qa.setAttribute('open', '');
          requestAnimationFrame(() => qa.classList.add('show'));
        }
      });
    });

    $$('.faq-filter button').forEach(btn => {
      btn.addEventListener('click', () => {
        $$('.faq-filter button').forEach(b =>
          b.setAttribute('aria-pressed', String(b === btn))
        );
        const f = btn.dataset.f;
        $$('.qa').forEach(qa => {
          qa.classList.toggle('hide', f !== 'all' && qa.dataset.cat !== f);
        });
      });
    });
  }

  /* ---------- nav active link ---------- */
  const sections = $$('main section[id]');
  const links = $$('.nav-links a');
  if (sections.length && links.length) {
    const sio = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        const id = '#' + e.target.id;
        links.forEach(l => l.classList.toggle('active', l.getAttribute('href') === id));
      });
    }, { rootMargin: '-45% 0px -50% 0px' });
    sections.forEach(s => sio.observe(s));
  }

})();
</script>
</body>
  </html>
