<script>document.documentElement.classList.add('js')</script>

<!-- ============ LOGO SPRITE (SVG) ============ -->
<svg width="0" height="0" style="position:absolute;overflow:hidden" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="gradAnim" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#6fdc5a">
        <animate attributeName="stop-color" values="#6fdc5a;#f1ffe8;#cfffb3;#a8f58a;#6fdc5a" dur="8s" repeatCount="indefinite"/>
      </stop>
      <stop offset="30%" stop-color="#cfffb3">
        <animate attributeName="stop-color" values="#cfffb3;#6fdc5a;#f1ffe8;#cfffb3;#cfffb3" dur="8s" repeatCount="indefinite"/>
      </stop>
      <stop offset="65%" stop-color="#a8f58a">
        <animate attributeName="stop-color" values="#a8f58a;#cfffb3;#6fdc5a;#f1ffe8;#a8f58a" dur="8s" repeatCount="indefinite"/>
      </stop>
      <stop offset="100%" stop-color="#f1ffe8">
        <animate attributeName="stop-color" values="#f1ffe8;#a8f58a;#cfffb3;#6fdc5a;#f1ffe8" dur="8s" repeatCount="indefinite"/>
      </stop>
    </linearGradient>

